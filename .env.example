WHATSAPP_PHONE_NUMBER_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — model IDs are swappable via env, see src/lib/llm.ts
OPENROUTER_API_KEY=
LLM_ROUTER_MODEL=qwen/qwen3.6-35b-a3b
LLM_ANSWER_MODEL=moonshotai/kimi-k2.5
LLM_EMBED_MODEL=baai/bge-m3

# Auth
MAGIC_LINK_BASE_URL=http://localhost:3000

# Acknowledgment strategy — see plan §Acknowledgment strategy.
# read_receipt: mark-as-read only, no reply text (assumes free — unverified,
#   confirm with Meta support before relying on this at scale).
# batched_digest: fallback if mark-as-read turns out to be billed.
ACK_MODE=read_receipt
