# Meta / WhatsApp Cloud API
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# The actual phone number (digits only, no +, no spaces — e.g. 15556514033),
# NOT the Phone Number ID above. Powers the wa.me link on the landing page
# (src/app/page.tsx) — exposed client-side, not a secret.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — model IDs are swappable via env, see src/lib/llm.ts
OPENROUTER_API_KEY=
LLM_ROUTER_MODEL=qwen/qwen3.6-35b-a3b
LLM_ANSWER_MODEL=moonshotai/kimi-k2.5

# Cloudflare Workers AI — hosts BGE-M3 embeddings (@cf/baai/bge-m3), dense
# only. Free account, pay-per-token beyond the free daily allowance.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Auth
MAGIC_LINK_BASE_URL=http://localhost:3000

# Acknowledgment strategy — see plan §Acknowledgment strategy.
# read_receipt: mark-as-read only, no reply text (assumes free — unverified,
#   confirm with Meta support before relying on this at scale).
# batched_digest: fallback if mark-as-read turns out to be billed.
ACK_MODE=read_receipt
